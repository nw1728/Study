# Copy this file to server/.env and fill it in. The server refuses to start
# if anything here is missing, so you find out now rather than on first use.

# Which port the server listens on.
PORT=3000

# Where the site is reached. Used for the Google redirect and for the Origin
# check that blocks saves coming from another site.
# Development: http://localhost:3000   Office: https://roboteamtwente.nl
PUBLIC_URL=http://localhost:3000

# Which login door is mounted. NO DEFAULT: leave it out and the server stops.
#   dev    = the development door, an email box. Anyone who can reach it gets in.
#   google = Sign in with Google, the real one.
# AUTH_MODE=dev together with NODE_ENV=production REFUSES TO START.
AUTH_MODE=dev

# development or production. Production also serves the built site from dist/.
NODE_ENV=development

# Only addresses on this domain may log in.
ALLOWED_DOMAIN=roboteamtwente.nl

# The first owner, written into users.json the very first time the server runs.
# Ignored afterwards: from then on the access list is the truth.
OWNER_EMAIL=e.bastian@roboteamtwente.nl

# Signs the login cookie. At least 32 characters, and secret.
# Make one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Where content, history, uploads and the access list live. Not in git:
# this is the real data on the office machine. Back it up by copying the folder.
STORAGE_DIR=./server/storage

# Only needed when AUTH_MODE=google. The team manager creates these in the
# Google Cloud Console, with the consent screen set to "Internal".
# Redirect URIs: http://localhost:3000/auth/google/callback  (development)
#                https://<site domain>/auth/google/callback  (office)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
